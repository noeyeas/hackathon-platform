# Supabase 프로젝트 설정 (supabase.com 대시보드 > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# 서버 전용 (Service Role) — 운영 집계·조회수 등 RLS 우회 작업에 사용.
# 절대 클라이언트 노출 금지 (NEXT_PUBLIC_ 접두사를 붙이지 말 것)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# 사이트 기본 URL. 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# /api/health (Supabase 자동 일시중단 방지 크론) 인증용.
# Vercel 프로젝트 환경 변수에 넣으면 Vercel Cron 이 Authorization 헤더를
# 자동으로 붙여준다. 값이 없으면 헬스체크는 401 로 닫힌다(fail-closed).
CRON_SECRET=아무_긴_랜덤_문자열
